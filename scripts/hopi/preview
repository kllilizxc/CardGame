#!/bin/sh
set -eu

script_dir=$(
    CDPATH= cd -- "$(dirname -- "$0")" && pwd -P
)
default_project_root=$(
    CDPATH= cd -- "$script_dir/../.." && pwd -P
)
project_root_input=${HOPI_PROJECT_ROOT:-$default_project_root}
project_root=$(
    CDPATH= cd -- "$project_root_input" && pwd -P
)

if [ ! -f "$project_root/package.json" ]; then
    echo "HOPI preview adapter error: package.json not found under $project_root" >&2
    exit 1
fi

if ! command -v bun >/dev/null 2>&1; then
    echo "HOPI preview adapter error: bun is required but was not found in PATH" >&2
    exit 127
fi

local_vite=$project_root/node_modules/.bin/vite
bun_cache_dir=

if [ -n "${HOPI_PREVIEW_RUNTIME_DIR:-}" ]; then
    runtime_tmp_dir=$HOPI_PREVIEW_RUNTIME_DIR/tmp
    bun_cache_dir=$HOPI_PREVIEW_RUNTIME_DIR/bun-install-cache
    mkdir -p -- "$runtime_tmp_dir" "$bun_cache_dir"
    export TMPDIR=$runtime_tmp_dir
    export BUN_TMPDIR=$runtime_tmp_dir
fi

if [ ! -x "$local_vite" ]; then
    cd -- "$project_root"
    mkdir -p -- "$project_root/node_modules" 2>/dev/null || true
    echo "HOPI preview adapter: preparing local dependencies with bun install --frozen-lockfile" >&2
    if [ -n "$bun_cache_dir" ]; then
        bun install --frozen-lockfile --cache-dir "$bun_cache_dir"
    else
        bun install --frozen-lockfile
    fi
fi

if [ ! -x "$local_vite" ]; then
    echo "HOPI preview adapter error: vite was not installed under $project_root/node_modules/.bin" >&2
    exit 127
fi

choose_preview_port() {
    bun --eval '
const net = require("node:net");

const server = net.createServer();
server.unref();
server.listen({ host: "127.0.0.1", port: 0 }, () => {
  const address = server.address();
  if (!address || typeof address === "string") {
    console.error("HOPI preview adapter error: failed to resolve an ephemeral loopback port");
    process.exitCode = 1;
    server.close();
    return;
  }

  process.stdout.write(String(address.port));
  server.close();
});
server.on("error", (error) => {
  console.error(`HOPI preview adapter error: failed to select a preview port: ${error.message}`);
  process.exit(1);
});
'
}

preview_endpoint_ready() {
    PREVIEW_PORT=$1 bun --eval '
const port = Number(process.env.PREVIEW_PORT);
const controller = new AbortController();
const timeout = setTimeout(() => controller.abort(), 750);

fetch(`http://127.0.0.1:${port}`, { signal: controller.signal }).then(
  () => {
    clearTimeout(timeout);
    process.exit(0);
  },
  () => {
    clearTimeout(timeout);
    process.exit(1);
  },
);
' >/dev/null 2>&1
}

preview_pid=

cleanup_preview_child() {
    if [ -n "${preview_pid:-}" ] && kill -0 "$preview_pid" 2>/dev/null; then
        kill "$preview_pid" 2>/dev/null || true
        wait "$preview_pid" 2>/dev/null || true
    fi
}

handle_termination() {
    trap - EXIT HUP INT TERM
    cleanup_preview_child
    exit 143
}

wait_for_preview_ready() {
    port=$1
    attempts=120

    while [ "$attempts" -gt 0 ]; do
        if ! kill -0 "$preview_pid" 2>/dev/null; then
            return 1
        fi

        if preview_endpoint_ready "$port"; then
            return 0
        fi

        attempts=$((attempts - 1))
        sleep 0.25
    done

    echo "HOPI preview adapter error: timed out waiting for http://127.0.0.1:$port to become reachable" >&2
    return 1
}

preview_port=$(choose_preview_port)
preview_url=http://127.0.0.1:$preview_port

export HOPI_PROJECT_ROOT=$project_root

trap cleanup_preview_child EXIT
trap handle_termination HUP INT TERM

cd -- "$project_root"
bun run dev-nolog -- --host 127.0.0.1 --port "$preview_port" --strictPort &
preview_pid=$!

if ! wait_for_preview_ready "$preview_port"; then
    if kill -0 "$preview_pid" 2>/dev/null; then
        cleanup_preview_child
        exit 1
    fi

    if wait "$preview_pid"; then
        echo "HOPI preview adapter error: preview process exited before readiness verification completed" >&2
        exit 1
    else
        exit $?
    fi
fi

export HOPI_PREVIEW_URL=$preview_url
printf 'HOPI_PREVIEW_URL=%s\n' "$preview_url"

if wait "$preview_pid"; then
    exit 0
else
    exit $?
fi
